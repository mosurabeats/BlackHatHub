# Executive Hub configuration. Copy to .env (the launchers do this automatically).
# This file holds secrets: keep it private (chmod 600). Never commit .env.

# --- Network --------------------------------------------------------------------
# 0.0.0.0 lets iPhone/iPad on your Wi-Fi (and Tailscale) reach the hub.
# Requests from public-internet addresses are rejected by the app regardless.
# Use 127.0.0.1 to restrict access to this Mac only.
EXECHUB_HOST=0.0.0.0
EXECHUB_PORT=8765
# Set to true only when served over HTTPS (e.g. `tailscale serve`).
EXECHUB_COOKIE_SECURE=false

# --- Storage --------------------------------------------------------------------
# Default: ./data (SQLite). For PostgreSQL (e.g. on a VPS later):
# EXECHUB_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/executive_hub
# EXECHUB_DATA_DIR=/path/to/data

# --- AI providers (optional; research works without them) -------------------------
# Used for unstructured sources (news/RSS analysis) and AI briefing summaries.
# Budgets are enforced in Settings -> AI budgets (default $3/day, $60/month).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Data sources ------------------------------------------------------------------
# Free key from your SAM.gov account (Account Details -> API Key) enables SAM.gov opportunities.
SAM_GOV_API_KEY=
# Optional Socrata app token raises open-data rate limits (https://dev.socrata.com/register).
SOCRATA_APP_TOKEN=

# --- Security tuning (defaults are sensible) ----------------------------------------
# EXECHUB_VAULT_IDLE_MINUTES=15
# EXECHUB_SESSION_HOURS=12
# EXECHUB_SESSION_IDLE_MINUTES=120
